          "kind": "citation_bearing_sentence",
          "matched_claim_ids": [
            "C07"
          ],
          "start_byte": 2037,
          "text": "(ESPÍRITO SANTO, 2021a)",
          "trigger_id": "TRIG-B2037-2061-b3b17b13efd0"
        }
      ],
      "uncovered_trigger_count": 0
    },
    {
      "candidate_id": "CAND-B2063-2407-0759bd6bec07",
